<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DeepOriBridge.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    KeyDown="OnPageKeyDown"
    AutomationProperties.AutomationId="DeepOriBridge.Diagnostics.Page">
    <Grid AutomationProperties.AutomationId="DeepOriBridge.Diagnostics.Page" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentGrid.Padding" Value="16,18,16,32" />
                        <Setter Target="IpcPanel.(Grid.Row)" Value="1" />
                        <Setter Target="IpcPanel.(Grid.Column)" Value="0" />
                        <Setter Target="CatalogPanel.(Grid.Row)" Value="3" />
                        <Setter Target="CatalogPanel.(Grid.Column)" Value="0" />
                        <Setter Target="DiagnosticsSecondaryColumn.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid RowDefinitions="Auto,*">
            <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton x:Name="BackButton" AutomationProperties.Name="返回首页" Click="OnBackClicked" Icon="Back" Label="返回" />
                <AppBarButton x:Name="RefreshButton" AutomationProperties.Name="刷新运行诊断" Click="OnRefreshClicked" Icon="Refresh" Label="重新检查" />
            </CommandBar>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ContentGrid" MaxWidth="1000" Padding="28,20,28,40" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock AutomationProperties.AutomationId="DeepOriBridge.Diagnostics.Page" FontSize="32" FontWeight="SemiBold" Text="运行诊断" />
                            <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="所有探测均为只读：不会打开数据库正文，不会修改 Codex 状态，也不会创建 Task。" />
                        </StackPanel>
                        <InfoBar x:Name="SummaryStatus" IsClosable="False" IsOpen="True" Message="正在核验本机 Windows Codex 接口…" Severity="Informational" Title="检查中" />
                        <Grid ColumnSpacing="14" RowSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DiagnosticsPrimaryColumn" Width="*" /><ColumnDefinition x:Name="DiagnosticsSecondaryColumn" Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource BridgeCardStyle}">
                                <StackPanel Spacing="7">
                                    <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="Codex Desktop / CLI" />
                                    <TextBlock x:Name="CodexVersionText" Text="检查中…" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CodexPathText" Style="{StaticResource BridgeSecondaryTextStyle}" Text="检查中…" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="IpcPanel" Grid.Column="1" Style="{StaticResource BridgeCardStyle}">
                                <StackPanel Spacing="7">
                                    <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="Windows IPC" />
                                    <TextBlock x:Name="PrivatePipeStatusText" Text="检查中…" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="仅报告本机实际探测结果，不套用 macOS Unix Socket。" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource BridgeCardStyle}">
                                <StackPanel Spacing="7">
                                    <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="state_5.sqlite（仅读文件头）" />
                                    <TextBlock x:Name="StateDatabaseStatusText" Text="检查中…" TextWrapping="Wrap" />
                                    <TextBlock x:Name="StateDatabasePathText" Style="{StaticResource BridgeSecondaryTextStyle}" Text="检查中…" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="CatalogPanel" Grid.Row="2" Grid.Column="1" Style="{StaticResource BridgeCardStyle}">
                                <StackPanel Spacing="7">
                                    <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="codex-dev.db（仅读文件头）" />
                                    <TextBlock x:Name="CatalogDatabaseStatusText" Text="检查中…" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CatalogDatabasePathText" Style="{StaticResource BridgeSecondaryTextStyle}" Text="检查中…" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource BridgeCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="Codex app-server" />
                                <TextBlock x:Name="AppServerStatusText" Text="正在检查初始化握手…" TextWrapping="Wrap" />
                                <TextBlock x:Name="ThreadListStatusText" Style="{StaticResource BridgeSecondaryTextStyle}" Text="正在执行 thread/list 只读请求…" TextWrapping="Wrap" />
                                <TextBlock x:Name="CheckedAtText" Style="{StaticResource BridgeSecondaryTextStyle}" Text="尚未完成检查" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
