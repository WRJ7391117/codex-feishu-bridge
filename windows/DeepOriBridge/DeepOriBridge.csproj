<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DeepOriBridge</RootNamespace>
    <Product>DeepOri Bridge for Windows</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BridgeDeveloperBuild Condition="'$(BridgeDeveloperBuild)' == ''">true</BridgeDeveloperBuild>
    <BridgeLocalPreviewSensitiveRuntime Condition="'$(BridgeLocalPreviewSensitiveRuntime)' == '' and '$(BridgeDeveloperBuild)' == 'true'">true</BridgeLocalPreviewSensitiveRuntime>
    <BridgeLocalPreviewSensitiveRuntime Condition="'$(BridgeLocalPreviewSensitiveRuntime)' == ''">false</BridgeLocalPreviewSensitiveRuntime>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DeepOriBridge.DeveloperBuild" Value="$(BridgeDeveloperBuild)" />
    <AssemblyMetadata Include="DeepOriBridge.LocalPreviewSensitiveRuntime" Value="$(BridgeLocalPreviewSensitiveRuntime)" />
    <AssemblyMetadata Include="DeepOriBridge.DeveloperCanonicalAppxRoot" Value="$([System.IO.Path]::GetFullPath('$(TargetDir)AppX'))" />
    <AssemblyMetadata Include="DeepOriBridge.DeveloperCanonicalLooseRoot" Value="$([System.IO.Path]::GetFullPath('$(TargetDir)'))" />
    <AssemblyMetadata Include="DeepOriBridge.CleanFirstRunUiTestToken"
                      Value="$(BridgeCleanFirstRunUiTestToken)"
                      Condition="'$(BridgeCleanFirstRunUiTestToken)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\CodexSkills\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Import Project="..\BuildSidecar.targets" />

  <Target Name="RefreshLocalPreviewAppxPayload" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)AppX\Assets\CodexSkills\deepori-bridge-setup;$(OutDir)AppX\Tools" />
    <Copy SourceFiles="$(OutDir)DeepOriBridge.dll;$(OutDir)DeepOriBridge.deps.json;$(OutDir)DeepOriBridge.runtimeconfig.json;$(OutDir)resources.pri"
          DestinationFolder="$(OutDir)AppX"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ProjectDir)Assets\CodexSkills\deepori-bridge-setup\SKILL.md"
          DestinationFiles="$(OutDir)AppX\Assets\CodexSkills\deepori-bridge-setup\SKILL.md"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ProjectDir)Assets\CodexSkills\deepori-bridge-setup\.deepori-bridge-managed"
          DestinationFiles="$(OutDir)AppX\Assets\CodexSkills\deepori-bridge-setup\.deepori-bridge-managed"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(BridgeSidecarOutputDir)\feishu-event-sidecar.exe;$(BridgeSidecarOutputDir)\feishu-event-sidecar.manifest.json"
          DestinationFolder="$(OutDir)AppX\Tools"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(ProjectDir)Tools\Watch-BridgeProcess.ps1" DestinationFolder="$(OutDir)AppX\Tools" />
  </Target>

  <Target Name="RejectDeveloperIdentityInReleaseCI" BeforeTargets="PrepareForBuild"
          Condition="'$(ContinuousIntegrationBuild)' == 'true' and '$(Configuration)' == 'Release'">
    <Error Condition="'$(BridgeDeveloperBuild)' != 'false'"
           Text="Release CI must set BridgeDeveloperBuild=false and use a signed package identity." />
    <Error Condition="'$(BridgeLocalPreviewSensitiveRuntime)' != 'false'"
           Text="Release CI must disable the unsigned local-preview sensitive runtime." />
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Tools\Watch-BridgeProcess.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Runtime JSON-RPC and Feishu payloads use reflection-based serialization. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
