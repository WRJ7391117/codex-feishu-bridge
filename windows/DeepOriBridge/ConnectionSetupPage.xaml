<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DeepOriBridge.ConnectionSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    KeyDown="OnPageKeyDown"
    AutomationProperties.AutomationId="DeepOriBridge.ConnectionSetup.Page"
    mc:Ignorable="d">

    <Grid AutomationProperties.AutomationId="DeepOriBridge.ConnectionSetup.Page" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SetupContent.Padding" Value="16,18,16,32" />
                        <Setter Target="ManualChoiceCard.(Grid.Row)" Value="1" />
                        <Setter Target="ManualChoiceCard.(Grid.Column)" Value="0" />
                        <Setter Target="CodexSidePanel.(Grid.Row)" Value="1" />
                        <Setter Target="CodexSidePanel.(Grid.Column)" Value="0" />
                        <Setter Target="ManualStatusPanel.(Grid.Row)" Value="1" />
                        <Setter Target="ManualStatusPanel.(Grid.Column)" Value="0" />
                        <Setter Target="ChoiceSecondaryColumn.Width" Value="0" />
                        <Setter Target="CodexSecondaryColumn.Width" Value="0" />
                        <Setter Target="ManualSecondaryColumn.Width" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="20,14" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" AutomationProperties.Name="返回首页" Click="OnBackClicked" ToolTipService.ToolTip="返回">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock AutomationProperties.AutomationId="DeepOriBridge.ConnectionSetup.Page" FontSize="20" FontWeight="SemiBold" Text="首次连接向导" />
                    <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="DeepOri Bridge for Windows · Windows 11" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="SetupContent" MaxWidth="1040" Padding="28,22,28,40" HorizontalAlignment="Stretch">
                    <Grid x:Name="ChoiceView">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="7">
                                <TextBlock FontSize="28" FontWeight="SemiBold" Text="选择配置方式" />
                                <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="你可以让 Codex 协助完成大部分设置，也可以按四步向导自己操作。两种方式使用相同的安全规则。" />
                            </StackPanel>
                            <Grid x:Name="ChoiceCardsGrid" ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ChoicePrimaryColumn" Width="*" />
                                    <ColumnDefinition x:Name="ChoiceSecondaryColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource BridgeCardStyle}">
                                    <StackPanel Spacing="14">
                                        <FontIcon HorizontalAlignment="Left" FontSize="34" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE945;" />
                                        <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="让 Codex 帮我配置" />
                                        <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="跨应用身份契约正在安全审计。审计通过前，Codex 自动配置保持阻断，避免误操作同机 DeepOri Agent Mesh。" />
                                        <Border HorizontalAlignment="Left" Style="{StaticResource BridgeBadgeStyle}">
                                            <TextBlock Text="安全审计阻断" />
                                        </Border>
                                        <Button x:Name="ChooseCodexButton" AutomationProperties.Name="Codex 配置因身份审计而禁用" Click="OnChooseCodexClicked" Content="身份审计通过后开放" IsEnabled="False" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ManualChoiceCard" Grid.Column="1" Style="{StaticResource BridgeCardStyle}">
                                    <StackPanel Spacing="14">
                                        <FontIcon HorizontalAlignment="Left" FontSize="34" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE7C9;" />
                                        <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="我自己手动配置" />
                                        <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="按照四步向导创建飞书应用、连接凭据、配置机器人，并添加可以使用的飞书账号。" />
                                        <Border HorizontalAlignment="Left" Style="{StaticResource BridgeBadgeStyle}">
                                            <TextBlock Text="适合逐项核对" />
                                        </Border>
                                        <Button x:Name="ChooseManualButton" AutomationProperties.Name="使用手动向导" Click="OnChooseManualClicked" Content="使用手动向导" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <InfoBar IsClosable="False" IsOpen="True" Message="无论选择哪种方式，App Secret 都只在 Bridge 的 PasswordBox 中输入，并由当前 Windows 用户的 Credential Locker 保存。Codex 自动配置当前 fail-closed；请使用右侧手动向导。" Severity="Warning" Title="本机安全边界" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="CodexView" Visibility="Collapsed">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="7">
                                <TextBlock FontSize="28" FontWeight="SemiBold" Text="把这段指令发给你的 Codex" />
                                <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="配置助手安装到当前 Windows 用户的 Codex Skills。App Secret 不会进入下面的指令。" />
                            </StackPanel>
                            <Grid ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CodexPrimaryColumn" Width="2*" />
                                    <ColumnDefinition x:Name="CodexSecondaryColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource BridgeCardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock FontWeight="SemiBold" Text="Windows 专用配置指令" />
                                        <TextBox x:Name="CodexPromptTextBox" MinHeight="320" AcceptsReturn="True" AutomationProperties.Name="Windows Codex 配置指令" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="CodexSidePanel" Grid.Column="1" Style="{StaticResource BridgeCardStyle}">
                                    <StackPanel Spacing="14">
                                        <InfoBar x:Name="CodexSkillStatus" IsClosable="False" IsOpen="True" Message="正在准备本地配置助手…" Severity="Informational" Title="准备中" />
                                        <TextBlock FontWeight="SemiBold" Text="人工 Gate" />
                                        <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="登录或二次验证；在 Bridge 中输入 Secret；批准权限并发布版本；明确选择项目权限。" />
                                        <Button x:Name="CopyAndOpenCodexButton" AutomationProperties.Name="复制指令并打开 Codex" Click="OnCopyAndOpenCodexClicked" Content="复制指令并打开 Codex" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="CopyCodexPromptButton" AutomationProperties.Name="仅复制指令" Click="OnCopyCodexPromptClicked" Content="仅复制指令" />
                                        <Button AutomationProperties.Name="改用手动配置" Click="OnChooseManualClicked" Content="改用手动配置" />
                                        <Button AutomationProperties.Name="返回配置方式选择" Click="OnReturnToChoiceClicked" Content="返回选择" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ManualView" Visibility="Collapsed">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="7">
                                <TextBlock FontSize="28" FontWeight="SemiBold" Text="手动配置" />
                                <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="四步完成飞书应用、Credential Locker、机器人发布与 owner 项目授权。" />
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <Grid x:Name="ManualProgressGrid" MinWidth="680" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ManualStep1Button" AutomationProperties.Name="第 1 步 创建应用" Click="OnStepButtonClicked" Content="1  创建应用" Tag="1" />
                                    <Button x:Name="ManualStep2Button" Grid.Column="1" AutomationProperties.Name="第 2 步 连接应用" Click="OnStepButtonClicked" Content="2  连接应用" Tag="2" />
                                    <Button x:Name="ManualStep3Button" Grid.Column="2" AutomationProperties.Name="第 3 步 配置机器人" Click="OnStepButtonClicked" Content="3  配置机器人" Tag="3" />
                                    <Button x:Name="ManualStep4Button" Grid.Column="3" AutomationProperties.Name="第 4 步 添加使用者" Click="OnStepButtonClicked" Content="4  添加使用者" Tag="4" />
                                </Grid>
                            </ScrollViewer>
                            <Grid ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ManualPrimaryColumn" Width="2*" />
                                    <ColumnDefinition x:Name="ManualSecondaryColumn" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource BridgeCardStyle}">
                                    <Grid>
                                        <StackPanel x:Name="ManualStep1Panel" Spacing="14">
                                            <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="创建企业自建应用" />
                                            <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="在飞书开放平台创建由你管理的企业自建应用，并确认当前账号拥有应用管理权限。" />
                                            <Button AutomationProperties.Name="打开飞书开放平台" Click="OnOpenDeveloperConsoleClicked" Content="打开飞书开放平台" />
                                            <Button AutomationProperties.Name="查看完整配置清单" Click="OnShowChecklistClicked" Content="查看完整配置清单" />
                                            <CheckBox x:Name="Step1Confirmation" Checked="OnCompletionInputChanged" Content="我已创建应用并确认拥有管理权限" />
                                        </StackPanel>
                                        <StackPanel x:Name="ManualStep2Panel" Spacing="14" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="连接你的飞书应用" />
                                            <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="App Secret 只在下方 PasswordBox 中输入，不显示、不写入命令行或文件。" />
                                            <TextBox x:Name="SetupAppIdTextBox" AutomationProperties.Name="飞书 App ID" Header="App ID" MaxLength="128" PlaceholderText="cli_…" TextChanged="OnSetupAppIdTextChanged" />
                                            <PasswordBox x:Name="SetupAppSecretPasswordBox" AutomationProperties.Name="飞书 App Secret" Header="App Secret" MaxLength="256" PasswordRevealMode="Peek" PlaceholderText="仅在此安全输入" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="VerifyCredentialButton" AutomationProperties.Name="保存并验证飞书凭据" Click="OnVerifyCredentialClicked" Content="保存并验证" Style="{StaticResource AccentButtonStyle}" />
                                                <Button x:Name="ClearCredentialButton" AutomationProperties.Name="重置本机飞书数据" Click="OnClearCredentialClicked" Content="重置本机飞书数据…" />
                                            </StackPanel>
                                            <InfoBar x:Name="CredentialStatus" IsClosable="False" IsOpen="True" Message="等待验证。" Severity="Informational" Title="连接检查" />
                                        </StackPanel>
                                        <StackPanel x:Name="ManualStep3Panel" Spacing="14" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="配置机器人并发布" />
                                            <TextBlock Text="1. 开启机器人能力" />
                                            <TextBlock Text="2. 添加消息、卡片、菜单事件与所需权限" />
                                            <TextBlock Text="3. 创建并发布应用版本" />
                                            <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="Bridge 只能验证 Bot 身份与飞书网络；权限、事件和发布状态仍以开放平台为准。" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Click="OnOpenDeveloperConsoleClicked" Content="打开飞书开放平台" />
                                                <Button Click="OnShowChecklistClicked" Content="查看完整配置清单" />
                                            </StackPanel>
                                            <Button x:Name="CheckBotConfigurationButton" AutomationProperties.Name="完成机器人配置并开始检查" Click="OnCheckBotConfigurationClicked" Content="我已完成，开始检查" Style="{StaticResource AccentButtonStyle}" />
                                            <InfoBar x:Name="BotConfigurationStatus" IsClosable="False" IsOpen="True" Message="完成开放平台设置后执行基础连接检查。" Severity="Informational" Title="等待人工配置" />
                                        </StackPanel>
                                        <StackPanel x:Name="ManualStep4Panel" Spacing="14" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource BridgeSectionTitleStyle}" Text="添加使用者并授权项目" />
                                            <TextBlock Style="{StaticResource BridgeSecondaryTextStyle}" Text="启动长连接后生成随机 6 位一次性验证码。验证码两分钟有效，只接受发送该验证码的飞书单聊用户。" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="StartSetupConnectionButton" AutomationProperties.Name="启动飞书长连接" Click="OnStartSetupConnectionClicked" Content="启动飞书连接" />
                                                <Button x:Name="ArmOwnerBindingButton" AutomationProperties.Name="添加飞书授权用户" Click="OnArmOwnerBindingClicked" Content="添加使用者" />
                                                <Button x:Name="ClearOwnerBindingButton" AutomationProperties.Name="撤销全部飞书用户授权" Click="OnClearOwnerBindingClicked" Content="撤销全部用户" />
                                            </StackPanel>
                                            <TextBlock x:Name="OwnerBindingStatus" Style="{StaticResource BridgeSecondaryTextStyle}" Text="尚未绑定 owner。" />
                                            <TextBox x:Name="ProjectPathTextBox" AutomationProperties.Name="允许的 Codex 项目目录" Header="允许的 Codex 项目目录" PlaceholderText="输入一个明确存在的完整目录路径" TextWrapping="Wrap" />
                                            <Button x:Name="SaveProjectAuthorizationButton" HorizontalAlignment="Left" AutomationProperties.Name="保存明确项目授权" Click="OnSaveProjectAuthorizationClicked" Content="保存这个项目授权" Style="{StaticResource AccentButtonStyle}" />
                                            <InfoBar x:Name="ProjectAuthorizationStatus" IsClosable="False" IsOpen="True" Message="必须保存一个明确存在的目录；空值、通配符和所有项目授权均被拒绝。" Severity="Warning" Title="项目权限人工 Gate" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="ManualStatusPanel" Grid.Column="1" Style="{StaticResource BridgeCardStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock x:Name="ManualStatusTitle" Style="{StaticResource BridgeSectionTitleStyle}" Text="完成后继续" />
                                        <TextBlock x:Name="ManualStatusDetail" Style="{StaticResource BridgeSecondaryTextStyle}" Text="完成本步可验证条件后继续。" />
                                        <Button x:Name="ManualBackButton" AutomationProperties.Name="返回上一步" Click="OnManualBackClicked" Content="返回" />
                                        <Button x:Name="ManualNextButton" AutomationProperties.Name="继续下一步" Click="OnManualNextClicked" Content="继续" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                                        <Button AutomationProperties.Name="返回配置方式选择" Click="OnReturnToChoiceClicked" Content="返回选择" />
                                        <TextBlock x:Name="ManualStepCounter" Style="{StaticResource BridgeSecondaryTextStyle}" Text="第 1 步，共 4 步" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
