+func (s *FeishuSource) persistWorkflowDecision(e *larkevent.EventReq) error {
+	directory := os.Getenv(workflowDecisionInboxEnv)
+	if directory == "" || e.Body == nil {
+		return nil
+	}
+	var envelope struct {
+		Header struct {
+			EventID   string `json:"event_id"`
+			EventType string `json:"event_type"`
+		} `json:"header"`
+		Event struct {
+			Action struct {
+				Value map[string]interface{} `json:"value"`
+			} `json:"action"`
+		} `json:"event"`
+	}
+	if err := json.Unmarshal(e.Body, &envelope); err != nil {
+		return fmt.Errorf("parse workflow decision callback: %w", err)
+	}
+	if envelope.Event.Action.Value["action"] != "workflow_decision" {
+		return nil
+	}
+	if envelope.Header.EventType != "card.action.trigger" ||
+		envelope.Header.EventID == "" || len(envelope.Header.EventID) > 512 ||
+		strings.IndexFunc(envelope.Header.EventID, func(character rune) bool {
+			return character < 32
+		}) >= 0 || len(e.Body) > maxEventBodyBytes {
+		return fmt.Errorf("invalid workflow decision callback")
+	}
+	directoryInfo, err := os.Lstat(directory)
+	if err != nil {
+		return fmt.Errorf("open workflow decision inbox: %w", err)
+	}
+	directoryStat, ok := directoryInfo.Sys().(*syscall.Stat_t)
+	if !ok || !directoryInfo.IsDir() || directoryInfo.Mode()&os.ModeSymlink != 0 ||
+		directoryInfo.Mode().Perm() != 0700 || directoryStat.Uid != uint32(os.Getuid()) {
+		return fmt.Errorf("workflow decision inbox is unsafe")
+	}
+	digest := sha256.Sum256([]byte(envelope.Header.EventID))
+	destination := filepath.Join(directory, fmt.Sprintf("%x.json", digest))
+	validateExisting := func() error {
+		info, statErr := os.Lstat(destination)
+		if statErr != nil {
+			return statErr
+		}
+		fileStat, validOwner := info.Sys().(*syscall.Stat_t)
+		if !validOwner || !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 ||
+			info.Mode().Perm() != 0600 || fileStat.Uid != uint32(os.Getuid()) {
+			return fmt.Errorf("workflow decision inbox entry is unsafe")
+		}
+		existing, readErr := os.ReadFile(destination)
+		if readErr != nil || !bytes.Equal(existing, e.Body) {
+			return fmt.Errorf("workflow decision inbox event conflicts")
+		}
+		return nil
+	}
+	if _, err := os.Lstat(destination); err == nil {
+		if err := validateExisting(); err != nil {
+			return err
+		}
+		if err := syncWorkflowDecisionInbox(directory); err != nil {
+			return fmt.Errorf("sync workflow decision inbox: %w", err)
+		}
+		return nil
+	} else if !os.IsNotExist(err) {
+		return fmt.Errorf("inspect workflow decision inbox: %w", err)
+	}
+	temporary, err := os.CreateTemp(directory, ".workflow-decision-*.tmp")
+	if err != nil {
+		return fmt.Errorf("create workflow decision inbox entry: %w", err)
+	}
+	temporaryPath := temporary.Name()
+	defer os.Remove(temporaryPath)
+	err = temporary.Chmod(0600)
+	if err == nil {
+		_, err = temporary.Write(e.Body)
+	}
+	if err == nil {
+		err = temporary.Sync()
+	}
+	closeErr := temporary.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return fmt.Errorf("write workflow decision inbox entry: %w", err)
+	}
+	if err := os.Link(temporaryPath, destination); err != nil {
+		if os.IsExist(err) {
+			if err := validateExisting(); err != nil {
+				return err
+			}
+			if err := syncWorkflowDecisionInbox(directory); err != nil {
+				return fmt.Errorf("sync workflow decision inbox: %w", err)
+			}
+			return nil
+		}
+		return fmt.Errorf("publish workflow decision inbox entry: %w", err)
+	}
+	if err := syncWorkflowDecisionInbox(directory); err != nil {
+		return fmt.Errorf("sync workflow decision inbox: %w", err)
+	}
+	return nil
+}
