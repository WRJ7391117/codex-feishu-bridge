+func TestDuplicateWorkflowCardActionDoesNotACKWhenDirectorySyncFails(t *testing.T) {
+	directory := t.TempDir()
+	if err := os.Chmod(directory, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(workflowDecisionInboxEnv, directory)
+	s := &FeishuSource{}
+	d := dispatcher.NewEventDispatcher("", "")
+	emitted := 0
+	s.registerHandlers(
+		d,
+		[]string{"card.action.trigger"},
+		s.buildRawHandler(func(_ *event.RawEvent) { emitted++ }),
+	)
+	payload := []byte(`{
+        "schema":"2.0",
+        "header":{"event_id":"evt-workflow-existing","event_type":"card.action.trigger","create_time":"1"},
+        "event":{"action":{"tag":"button","value":{"action":"workflow_decision"}}}
+    }`)
+	if _, err := d.Do(context.Background(), payload); err != nil {
+		t.Fatalf("first workflow callback: %v", err)
+	}
+
+	originalSync := syncWorkflowDecisionInbox
+	syncWorkflowDecisionInbox = func(string) error {
+		return fmt.Errorf("forced directory sync failure")
+	}
+	defer func() { syncWorkflowDecisionInbox = originalSync }()
+	response, err := d.Do(context.Background(), payload)
+	if err == nil || response != nil {
+		t.Fatalf("duplicate callback response = %T, err = %v", response, err)
+	}
+	if emitted != 1 {
+		t.Fatalf("duplicate callback emitted after failed directory sync: %d", emitted)
+	}
+}
