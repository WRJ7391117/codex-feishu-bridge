+func TestWorkflowCardActionIsDurableBeforeCallbackResponse(t *testing.T) {
+	directory := t.TempDir()
+	if err := os.Chmod(directory, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(workflowDecisionInboxEnv, directory)
+	s := &FeishuSource{}
+	d := dispatcher.NewEventDispatcher("", "")
+	var received *event.RawEvent
+	s.registerHandlers(
+		d,
+		[]string{"card.action.trigger"},
+		s.buildRawHandler(func(raw *event.RawEvent) { received = raw }),
+	)
+	payload := []byte(`{
+        "schema":"2.0",
+        "header":{"event_id":"evt-workflow","event_type":"card.action.trigger","create_time":"1"},
+        "event":{"operator":{"open_id":"ou_test"},"action":{"tag":"button","value":{"action":"workflow_decision"}}}
+    }`)
+	response, err := d.Do(context.Background(), payload)
+	if err != nil {
+		t.Fatalf("dispatch workflow card action: %v", err)
+	}
+	if received == nil {
+		t.Fatal("workflow card action was not emitted")
+	}
+	if _, ok := response.(*callback.CardActionTriggerResponse); !ok {
+		t.Fatalf("response type = %T", response)
+	}
+	digest := sha256.Sum256([]byte("evt-workflow"))
+	path := filepath.Join(directory, fmt.Sprintf("%x.json", digest))
+	stored, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read durable workflow callback: %v", err)
+	}
+	if string(stored) != string(payload) {
+		t.Fatal("durable workflow callback does not match received payload")
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatalf("stat durable workflow callback: %v", err)
+	}
+	if info.Mode().Perm() != 0600 {
+		t.Fatalf("durable workflow callback permissions = %v", info.Mode().Perm())
+	}
+	if _, err := d.Do(context.Background(), payload); err != nil {
+		t.Fatalf("duplicate workflow callback: %v", err)
+	}
+	entries, err := os.ReadDir(directory)
+	if err != nil || len(entries) != 1 {
+		t.Fatalf("durable workflow callback entries = %d, err = %v", len(entries), err)
+	}
+}
